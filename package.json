{
  "name": "wagtail-autocomplete",
  "version": "0.0.0",
  "description": "An Autocomplete edit handler for Pages, Snippets, and more.",
  "repository": "https://littleweaver/wagtail-autocomplete",
  "license": "BSD-3-Clause",
  "main": "client/src/index.js",
  "overrides": {
    "cheerio": "1.0.0-rc.12",
    "babel-preset-current-node-syntax": {
      "@babel/core": "$@babel/core"
    }
  },
  "jest": {
    "testEnvironment": "jsdom",
    "moduleNameMapper": {
      "\\.scss$": "<rootDir>/client/src/__mocks__/styleMock.js"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/client/src/jest.setup.js"
    ]
  },
  "scripts": {
    "build": "webpack --mode production",
    "start": "webpack watch --devtool eval-source-map --mode development",
    "lint:js": "eslint client wagtailautocomplete/static",
    "lint:js:fix": "eslint --fix client wagtailautocomplete/static",
    "lint:css": "stylelint \"client/**/*.scss\"",
    "test": "jest client"
  },
  "stylelint": {
    "extends": "@wagtail/stylelint-config-wagtail",
    "rules": {
      "scss/selector-no-union-class-name": null,
      "scss/selector-class-pattern": null
    }
  },
  "author": "Emily Horsman <me@emilyhorsman.com>",
  "devDependencies": {
    "@babel/cli": "^8.0.6",
    "@babel/core": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@babel/preset-react": "^8.0.1",
    "@eslint/js": "^9.39.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@wagtail/eslint-config-wagtail": "^1.0.0",
    "@wagtail/stylelint-config-wagtail": "^2.0.0",
    "autoprefixer": "^10.6.1",
    "babel-jest": "^30.5.2",
    "babel-loader": "^10.1.1",
    "css-loader": "^6.11.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "mini-css-extract-plugin": "^1.6.2",
    "postcss": "^8.5.28",
    "postcss-loader": "^8.2.1",
    "sass": "^1.105.1",
    "sass-loader": "^17.0.1",
    "stylelint": "^17.16.0",
    "typescript-eslint": "^8.71.0",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-merge": "^6.0.1"
  },
  "dependencies": {
    "classlist-polyfill": "^1.2.0",
    "classnames": "^2.5.1",
    "element-dataset": "^2.2.6",
    "js-cookie": "^3.0.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
